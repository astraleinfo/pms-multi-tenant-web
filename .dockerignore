# Everything the build recreates, or must not see.

# dependencies and build output — installed and built inside the image
node_modules
.next
out
build
coverage
*.tsbuildinfo
next-env.d.ts

# env files: NEXT_PUBLIC_* values are inlined at build time, so a local
# .env.local here would ship its 127.0.0.1 addresses to production
.env*

# vcs, editors, docs, container files
.git
.gitignore
.vscode
.idea
.claude
*.md
!public/**/*.md
Dockerfile
.dockerignore
docker-compose*.yml

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem
